GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated chat model IDs available to your Groq account (see test.py).
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b
GOOGLE_API_KEY=replace-with-your-google-ai-studio-api-key
GOOGLE_SEARCH_MODEL=gemini-3.8-flash
TAVILY_API_KEY=replace-with-your-tavily-api-key
BLOG_OUTPUT_DIR=output

# Required only for DeepEval's judge; these must be OpenRouter :free models.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
DEEPEVAL_MODEL=nvidia/nemotron-3.5-super-vl:free
DEEPEVAL_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free